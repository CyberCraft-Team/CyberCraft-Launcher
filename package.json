{
  "name": "cybercraft-launcher",
  "productName": "CyberCraft Launcher",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:app": "npm run build && electron-builder",
    "build:dir": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win portable",
    "package:win": "npm run build && node scripts/package.js",
    "build:linux": "npm run build && electron-builder --linux AppImage deb tar.gz",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "start": "next start",
    "lint": "eslint .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && cross-env PORT=3000 electron .\"",
    "electron:start": "npm run build && cross-env NODE_ENV=production electron ."
  },
  "build": {
    "appId": "uz.cybercraft.launcher",
    "productName": "CyberCraft Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "out/**/*",
      "utils/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "cybercraft",
      "repo": "cybercraft-launcher",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "nsis-web",
        "portable"
      ],
      "publish": {
        "provider": "github",
        "owner": "cybercraft",
        "repo": "cybercraft-launcher"
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "publish": {
        "provider": "github",
        "owner": "cybercraft",
        "repo": "cybercraft-launcher"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Game",
      "publish": {
        "provider": "github",
        "owner": "cybercraft",
        "repo": "cybercraft-launcher"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "minecraft-launcher-core": "^3.18.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "postcss": "^8.5",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "wait-on": "^9.0.10"
  }
}
